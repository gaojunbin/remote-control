{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-control.dev/schema/v1/http.json",
  "title": "remote-control gateway HTTP bodies (protocol v1)",
  "description": "Request and response bodies for /api/*. Browsers authenticate with the HttpOnly cookie rc_session; native apps send Authorization: Bearer <token>. Cookie-authenticated mutating requests must carry Origin == PUBLIC_ORIGIN.",
  "$defs": {
    "ErrorResponse": {
      "description": "Any 4xx/5xx JSON body.",
      "type": "object",
      "properties": {
        "ok": { "const": false },
        "error": { "$ref": "objects.json#/$defs/Error" }
      },
      "required": ["ok", "error"]
    },
    "OkResponse": {
      "description": "POST /api/logout, DELETE /api/devices/{device_id}, DELETE /api/devices/pairing/{code}, POST/DELETE /api/push/*.",
      "type": "object",
      "properties": { "ok": { "const": true } },
      "required": ["ok"]
    },

    "HealthResponse": {
      "description": "GET /api/health (unauthenticated).",
      "type": "object",
      "properties": {
        "ok": { "const": true },
        "version": { "type": "string", "minLength": 1 },
        "protocol": { "const": 1 },
        "auth": {
          "type": "object",
          "properties": { "mode": { "const": "password" } },
          "required": ["mode"]
        }
      },
      "required": ["ok", "version", "protocol", "auth"]
    },

    "LoginRequest": {
      "description": "POST /api/login (unauthenticated, rate limited to 5 per minute per IP).",
      "type": "object",
      "properties": {
        "password": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 }
      },
      "required": ["password"]
    },
    "LoginResponse": {
      "description": "200 from POST /api/login. Also sets the rc_session cookie (SameSite=Strict, Secure under https). The token value is the same one native apps send as a bearer.",
      "type": "object",
      "properties": {
        "ok": { "const": true },
        "token": { "type": "string", "minLength": 1 },
        "exp": { "$ref": "objects.json#/$defs/Timestamp" },
        "user": {
          "type": "object",
          "properties": { "username": { "type": "string", "minLength": 1 } },
          "required": ["username"]
        }
      },
      "required": ["ok", "token", "exp", "user"]
    },
    "AuthSessionResponse": {
      "description": "GET /api/session.",
      "type": "object",
      "properties": {
        "ok": { "const": true },
        "user": {
          "type": "object",
          "properties": { "username": { "type": "string", "minLength": 1 } },
          "required": ["username"]
        },
        "exp": { "$ref": "objects.json#/$defs/Timestamp" }
      },
      "required": ["ok", "user", "exp"]
    },
    "ConfigResponse": {
      "description": "GET /api/config.",
      "type": "object",
      "properties": {
        "public_origin": { "type": "string", "minLength": 1 },
        "stt": { "$ref": "app_frames.json#/$defs/SttInfo" },
        "push": {
          "type": "object",
          "properties": {
            "web_enabled": { "type": "boolean" },
            "apns_enabled": { "type": "boolean" }
          },
          "required": ["web_enabled", "apns_enabled"]
        },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["public_origin", "stt", "push", "version"]
    },

    "EnrollRequest": {
      "description": "POST /api/devices/enroll (unauthenticated; the pairing code is the credential). 404 unknown or expired code, 409 already used.",
      "type": "object",
      "properties": {
        "code": { "$ref": "objects.json#/$defs/PairingCode" },
        "name": { "type": "string", "minLength": 1 },
        "platform": { "$ref": "objects.json#/$defs/Platform" },
        "hostname": { "type": "string" },
        "arch": { "$ref": "objects.json#/$defs/Arch" },
        "client_version": { "type": "string", "minLength": 1 },
        "agents": { "type": "array", "items": { "$ref": "objects.json#/$defs/AgentInfo" } }
      },
      "required": ["code", "name", "platform", "hostname", "arch", "client_version"]
    },
    "EnrollResponse": {
      "description": "200 from POST /api/devices/enroll. device_token is shown once and stored hashed.",
      "type": "object",
      "properties": {
        "device_id": { "$ref": "objects.json#/$defs/Uuid" },
        "device_token": { "type": "string", "minLength": 1 },
        "gateway_ws_url": { "type": "string", "minLength": 1 }
      },
      "required": ["device_id", "device_token", "gateway_ws_url"]
    },

    "DeviceListResponse": {
      "description": "GET /api/devices.",
      "type": "object",
      "properties": {
        "devices": { "type": "array", "items": { "$ref": "objects.json#/$defs/Device" } }
      },
      "required": ["devices"]
    },
    "DevicePatchRequest": {
      "description": "PATCH /api/devices/{device_id}.",
      "type": "object",
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "required": ["name"]
    },
    "DeviceResponse": {
      "description": "200 from PATCH /api/devices/{device_id}.",
      "type": "object",
      "properties": { "device": { "$ref": "objects.json#/$defs/Device" } },
      "required": ["device"]
    },

    "PairingResponse": {
      "description": "POST /api/devices/pairing. Each install value is a full shell one-liner.",
      "type": "object",
      "properties": {
        "code": { "$ref": "objects.json#/$defs/PairingCode" },
        "expires_at": { "$ref": "objects.json#/$defs/Timestamp" },
        "install": {
          "type": "object",
          "properties": {
            "macos": { "type": "string", "minLength": 1 },
            "linux": { "type": "string", "minLength": 1 }
          },
          "required": ["macos", "linux"]
        }
      },
      "required": ["code", "expires_at", "install"]
    },

    "SessionListResponse": {
      "description": "GET /api/sessions?device_id=&archived= . Gateway index; last known summaries.",
      "type": "object",
      "properties": {
        "sessions": { "type": "array", "items": { "$ref": "objects.json#/$defs/Session" } }
      },
      "required": ["sessions"]
    },

    "SttTranscribeResponse": {
      "description": "200 from POST /api/stt/transcribe (multipart: audio as wav|webm|m4a|mp3, optional language). 503 with error code \"unsupported\" when STT is not configured.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "language": { "type": "string", "minLength": 1 }
      },
      "required": ["text", "language"]
    },

    "VapidResponse": {
      "description": "GET /api/push/web/vapid.",
      "type": "object",
      "properties": { "public_key": { "type": "string", "minLength": 1 } },
      "required": ["public_key"]
    },
    "WebPushSubscribeRequest": {
      "description": "POST /api/push/web/subscribe. `subscription` is the browser PushSubscription serialised with toJSON().",
      "type": "object",
      "properties": {
        "subscription": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string", "minLength": 1 },
            "expirationTime": { "type": ["integer", "null"] },
            "keys": {
              "type": "object",
              "properties": {
                "p256dh": { "type": "string", "minLength": 1 },
                "auth": { "type": "string", "minLength": 1 }
              },
              "required": ["p256dh", "auth"]
            }
          },
          "required": ["endpoint", "keys"]
        }
      },
      "required": ["subscription"]
    },
    "WebPushUnsubscribeRequest": {
      "description": "DELETE /api/push/web/subscribe.",
      "type": "object",
      "properties": { "endpoint": { "type": "string", "minLength": 1 } },
      "required": ["endpoint"]
    },
    "ApnsRegisterRequest": {
      "description": "POST /api/push/apns/register.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["sandbox", "production"] },
        "bundle_id": { "type": "string", "minLength": 1 }
      },
      "required": ["token", "environment", "bundle_id"]
    },
    "ApnsUnregisterRequest": {
      "description": "DELETE /api/push/apns/register.",
      "type": "object",
      "properties": { "token": { "type": "string", "minLength": 1 } },
      "required": ["token"]
    },

    "PushPayload": {
      "description": "Carried by both Web Push JSON and APNs custom data. The visible notification text is generic; no prompt or tool output ever appears in a push.",
      "type": "object",
      "properties": {
        "rc": {
          "type": "object",
          "properties": {
            "v": { "const": 1 },
            "kind": { "enum": ["needs_approval", "needs_input", "turn_completed", "error"] },
            "device_id": { "$ref": "objects.json#/$defs/Uuid" },
            "session_id": { "$ref": "objects.json#/$defs/Id" },
            "device_name": { "type": "string", "minLength": 1 },
            "title": { "type": "string" }
          },
          "required": ["v", "kind", "device_id", "session_id", "device_name", "title"]
        }
      },
      "required": ["rc"]
    }
  }
}
