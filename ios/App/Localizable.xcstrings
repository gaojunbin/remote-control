    "%@ loses its access token and its sessions disappear from this gateway. Agent transcripts on the machine are untouched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ loses its access token and its sessions disappear from this gateway. Agent transcripts on the machine are untouched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的访问令牌将被吊销，其会话会从本网关消失。机器上的 agent 记录不受影响。"
          }
        }
      }
    },
