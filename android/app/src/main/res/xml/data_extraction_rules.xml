<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a transfer to a new one, as on the iPhone, where the
     token's Keychain item is this-device-only: the sealed token would not open elsewhere anyway
     (its key stays in this phone's Keystore), and the preferences are the account's (A41), which
     a sign-in on the new phone brings back. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
