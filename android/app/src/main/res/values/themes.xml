<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the first frame is the page colour, so launch shows the canvas and
         nothing else, as the iPhone's launch does. Everything else is drawn by Compose. -->
    <style name="Theme.RemoteControl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
